      "detail": "admin name auto-granted GM level 6",
      "fix": "Hardened candidate removes name-based GM privilege"
    },
    {
      "id": "AUTH-003",
      "source": "AdminBackend.cs",
      "detail": "first-run seed admin/admin password and credential exposed in status output",
      "fix": "Hardened candidate requires 16+ char bootstrap password from environment"
    },
    {
      "id": "AUTH-004",
      "source": "InProcessTransport.cs",
      "detail": "CharList, CreateChar, CharSelect and other requests trust caller supplied account/character IDs",
      "fix": "Remote service must bind these operations to a validated session and verify ownership"
    },
    {
      "id": "NET-001",
      "source": "GameServer.cs",
      "detail": "GameServer.Start creates InProcessTransport and static Local singleton",
      "fix": "Refactor into platform-neutral server and authenticated transport"
    },
    {
